@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-4 py-lg-5">

    <div class="row justify-content-center">

        <div class="col-12 col-sm-11 col-md-8 col-lg-6 col-xl-5">

            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">

                <!-- Header -->
                <div class="card-header text-white text-center py-4"
                     style="background:linear-gradient(135deg,#0f172a,#1e40af,#3b82f6);">

                    <i class="bi bi-shield-lock-fill display-2"></i>

                    <h2 class="fw-bold mt-3 mb-1">
                        Access Denied
                    </h2>

                    <p class="mb-0 text-info">
                        You don't have permission to view this page
                    </p>

                </div>

                <!-- Body -->
                <div class="card-body p-4 p-md-5 text-center">

                    <div class="mb-4">

                        <i class="bi bi-exclamation-triangle-fill text-warning display-4"></i>

                    </div>

                    <h4 class="fw-semibold mb-3">
                        Permission Required
                    </h4>

                    <p class="text-muted mb-4">
                        The page or resource you requested requires permissions that
                        your account doesn't currently have.
                    </p>

                    <div class="alert alert-warning text-start">

                        <i class="bi bi-info-circle-fill me-2"></i>

                        If you believe this is a mistake, please contact an
                        administrator or sign in with an account that has the
                        appropriate permissions.

                    </div>

                    <div class="d-grid d-md-flex justify-content-center gap-3 mt-4">

                        <a asp-area="Customer"
                           asp-controller="Home"
                           asp-action="Index"
                           class="btn btn-primary btn-lg">

                            <i class="bi bi-house-door-fill me-2"></i>

                            Return Home

                        </a>

                        <a asp-area="Identity"
                           asp-controller="Account"
                           asp-action="Login"
                           class="btn btn-outline-primary btn-lg">

                            <i class="bi bi-box-arrow-in-right me-2"></i>

                            Login

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>