@model RegisterVM

<div class="container py-4 py-lg-5">

    <div class="row justify-content-center">

        <div class="col-12 col-sm-11 col-md-10 col-lg-8 col-xl-7">

            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">

                <div class="card-header text-white text-center py-4"
                     style="background:linear-gradient(135deg,#0f172a,#1e40af,#3b82f6);">

                    <i class="bi bi-person-plus-fill display-4"></i>

                    <h2 class="fw-bold mt-3 mb-1">
                        Create New User Account
                    </h2>

                    <p class="mb-0 text-info">
                        Join our motorcycle community
                    </p>

                </div>

                <div class="card-body p-3 p-md-4 p-lg-5">

                    <form asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"></div>

                        <!-- Name & Email -->
                        <div class="row g-3">

                            <div class="col-12 col-md-6">

                                <label asp-for="Name" class="form-label"></label>

                                <input asp-for="Name"
                                       class="form-control"
                                       placeholder="Miro Resutik" />

                                <span asp-validation-for="Name"
                                      class="text-danger"></span>

                            </div>

                            <div class="col-12 col-md-6">

                                <label asp-for="Email" class="form-label"></label>

                                <input asp-for="Email"
                                       class="form-control"
                                       placeholder="john@example.com" />

                                <span asp-validation-for="Email"
                                      class="text-danger"></span>

                            </div>

                        </div>

                        <!-- Password -->
                        <div class="row g-3 mt-1">

                            <div class="col-12 col-md-6">

                                <label asp-for="Password" class="form-label"></label>

                                <input asp-for="Password"
                                       class="form-control"
                                       placeholder="••••••••" />

                                <span asp-validation-for="Password"
                                      class="text-danger"></span>

                            </div>

                            <div class="col-12 col-md-6">

                                <label asp-for="ConfirmPassword" class="form-label"></label>

                                <input asp-for="ConfirmPassword"
                                       class="form-control"
                                       placeholder="••••••••" />

                                <span asp-validation-for="ConfirmPassword"
                                      class="text-danger"></span>

                            </div>

                        </div>

                        <!-- Phone -->
                        <div class="mt-3">

                            <label asp-for="PhoneNumber" class="form-label"></label>

                            <input asp-for="PhoneNumber"
                                   class="form-control"
                                   placeholder="+44 7912 345678" />

                            <span asp-validation-for="PhoneNumber"
                                  class="text-danger"></span>

                        </div>

                        <!-- Address -->
                        <div class="mt-3">

                            <label asp-for="StreetAddress" class="form-label"></label>

                            <input asp-for="StreetAddress"
                                   class="form-control"
                                   placeholder="45 Example Street" />

                            <span asp-validation-for="StreetAddress"
                                  class="text-danger"></span>

                        </div>

                        <!-- City / Country / Postcode -->
                        <div class="row g-3 mt-1">

                            <div class="col-12 col-md-5">

                                <label asp-for="City" class="form-label"></label>

                                <input asp-for="City"
                                       class="form-control"
                                       placeholder="Bristol" />

                            </div>

                            <div class="col-12 col-md-4">

                                <label asp-for="State" class="form-label">
                                    Country
                                </label>

                                <input asp-for="State"
                                       class="form-control"
                                       placeholder="United Kingdom" />

                            </div>

                            <div class="col-12 col-md-3">

                                <label asp-for="PostCode" class="form-label"></label>

                                <input asp-for="PostCode"
                                       class="form-control"
                                       placeholder="BS1 1AA" />

                            </div>

                        </div>

                        <!-- Role -->
                        <div class="mt-3">

                            <label asp-for="Role" class="form-label"></label>

                            <select asp-for="Role"
                                    asp-items="@Model.RoleList"
                                    class="form-select">

                                <option disabled selected>
                                    -- Select Role --
                                </option>

                            </select>

                        </div>

                        <button type="submit"
                                class="btn btn-primary btn-lg w-100 mt-4">

                            <i class="bi bi-person-check me-2"></i>

                            Register

                        </button>

                    </form>

                    <hr class="my-4" />

                    <div class="text-center">

                        Already have an account?

                        <a asp-action="Login"
                           asp-controller="Account"
                           asp-route-returnUrl="@ViewData["ReturnUrl"]"
                           class="fw-bold text-decoration-none">

                            Log in

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}