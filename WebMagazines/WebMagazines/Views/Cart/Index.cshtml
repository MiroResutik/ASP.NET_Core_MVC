@model ShoppingCartVM

@{
    ViewData["Title"] = "Shopping Cart";
    var itemCount = Model.ShoppingCartList.Count();
}

<div class="shopping-cart-page">
    <div class="container cart-container">

        <!-- Page heading -->
        <div class="cart-page-heading">
            <div>
                <span class="cart-eyebrow">YOUR SHOPPING BAG</span>
                <h1>Shopping Cart</h1>
                <p>Review your magazines before checking out.</p>
            </div>

            <a asp-area="Customer"
               asp-controller="Home"
               asp-action="Index"
               class="cart-continue-link">
                <i class="bi bi-arrow-left"></i>
                Continue Shopping
            </a>
        </div>

        <form method="post">
            <div class="row g-4 align-items-start">

                <!-- LEFT: Cart items -->
                <div class="col-lg-7">
                    <div class="cart-panel">

                        <div class="cart-panel-header">
                            <div class="d-flex align-items-center gap-3">
                                <div class="cart-heading-icon">
                                    <i class="bi bi-bag"></i>
                                </div>
                                <div>
                                    <h2>Your Items</h2>
                                    <p>Manage your selected magazines</p>
                                </div>
                            </div>

                            <span class="cart-item-count">
                                @itemCount @(itemCount == 1 ? "item" : "items")
                            </span>
                        </div>

                        @if (itemCount == 0)
                        {
                            <div class="cart-empty-state">
                                <div class="cart-empty-icon">
                                    <i class="bi bi-cart-x"></i>
                                </div>
                                <h3>Your cart is empty</h3>
                                <p>Looks like you haven't added any magazines yet.</p>
                                <a asp-area="Customer"
                                   asp-controller="Home"
                                   asp-action="Index"
                                   class="btn cart-primary-btn">
                                    <i class="bi bi-compass me-2"></i>
                                    Explore Magazines
                                </a>
                            </div>
                        }
                        else
                        {
                            <div class="cart-items-list">
                                @foreach (var item in Model.ShoppingCartList)
                                {
                                    <div class="cart-product-row">

                                        <!-- Product image -->
                                        <a asp-area="Customer"
                                           asp-controller="Home"
                                           asp-action="Details"
                                           asp-route-productId="@item.Product.Id"
                                           class="cart-product-image">
                                            @if (!string.IsNullOrEmpty(item.Product.ImageUrl))
                                            {
                                                <img src="@item.Product.ImageUrl"
                                                     alt="@item.Product.Name" />
                                            }
                                            else
                                            {
                                                <div class="cart-image-placeholder">
                                                    <i class="bi bi-journal-richtext"></i>
                                                </div>
                                            }
                                        </a>

                                        <!-- Product details -->
                                        <div class="cart-product-details">
                                            <a asp-area="Customer"
                                               asp-controller="Home"
                                               asp-action="Details"
                                               asp-route-productId="@item.Product.Id"
                                               class="cart-product-name">
                                                @item.Product.Name
                                            </a>

                                            <p class="cart-product-author">
                                                <i class="bi bi-person me-1"></i>
                                                @item.Product.Author
                                            </p>

                                            <p class="cart-unit-price">
                                                @item.Price.ToString("c") <span>each</span>
                                            </p>

                                            <div class="cart-quantity-control">
                                                <a asp-action="minus"
                                                   asp-route-cartId="@item.Id"
                                                   class="cart-quantity-btn"
                                                   aria-label="Decrease quantity">
                                                    <i class="bi bi-dash"></i>
                                                </a>

                                                <input type="number"
                                                       value="@item.Count"
                                                       min="1"
                                                       max="99"
                                                       aria-label="Quantity for @item.Product.Name"
                                                       class="cart-quantity-input"
                                                       onchange="updateCart(@item.Id, this.value)" />

                                                <a asp-action="plus"
                                                   asp-route-cartId="@item.Id"
                                                   class="cart-quantity-btn"
                                                   aria-label="Increase quantity">
                                                    <i class="bi bi-plus"></i>
                                                </a>
                                            </div>
                                        </div>

                                        <!-- Price and remove -->
                                        <div class="cart-product-total">
                                            <span class="cart-line-total">
                                                @((item.Price * item.Count).ToString("c"))
                                            </span>

                                            <a asp-action="Remove"
                                               asp-route-cartId="@item.Id"
                                               class="cart-remove-link">
                                                <i class="bi bi-trash3"></i>
                                                <span>Remove</span>
                                            </a>
                                        </div>
                                    </div>
                                }
                            </div>

                            <div class="cart-panel-footer">
                                <i class="bi bi-shield-check"></i>
                                Your selected magazines are ready for checkout.
                            </div>
                        }
                    </div>
                </div>

                <!-- RIGHT: Checkout -->
                <div class="col-lg-5">
                    <div class="cart-checkout-panel">

                        <div class="checkout-heading">
                            <div class="checkout-heading-icon">
                                <i class="bi bi-credit-card"></i>
                            </div>
                            <div>
                                <h2>Checkout</h2>
                                <p>Delivery details and order summary</p>
                            </div>
                        </div>

                        <fieldset disabled="@(itemCount == 0)">

                            <!-- Contact details -->
                            <div class="checkout-section">
                                <h3 class="checkout-section-title">
                                    <i class="bi bi-person-vcard"></i>
                                    Contact Details
                                </h3>

                                <div class="mb-3">
                                    <label asp-for="OrderHeader.Name" class="cart-form-label">
                                        Full Name
                                    </label>
                                    <input asp-for="OrderHeader.Name"
                                           class="form-control cart-form-control"
                                           placeholder="Enter your full name"
                                           autocomplete="name" />
                                    <span asp-validation-for="OrderHeader.Name"
                                          class="text-danger small"></span>
                                </div>

                                <div>
                                    <label asp-for="OrderHeader.PhoneNumber" class="cart-form-label">
                                        Phone Number
                                    </label>
                                    <input asp-for="OrderHeader.PhoneNumber"
                                           class="form-control cart-form-control"
                                           placeholder="Enter your phone number"
                                           autocomplete="tel" />
                                    <span asp-validation-for="OrderHeader.PhoneNumber"
                                          class="text-danger small"></span>
                                </div>
                            </div>

                            <div class="checkout-divider"></div>

                            <!-- Shipping address -->
                            <div class="checkout-section">
                                <h3 class="checkout-section-title">
                                    <i class="bi bi-geo-alt"></i>
                                    Shipping Address
                                </h3>

                                <div class="mb-3">
                                    <label asp-for="OrderHeader.StreetAddress" class="cart-form-label">
                                        Street Address
                                    </label>
                                    <input asp-for="OrderHeader.StreetAddress"
                                           class="form-control cart-form-control"
                                           placeholder="House number and street"
                                           autocomplete="street-address" />
                                    <span asp-validation-for="OrderHeader.StreetAddress"
                                          class="text-danger small"></span>
                                </div>

                                <div class="row g-3">
                                    <div class="col-6">
                                        <label asp-for="OrderHeader.City" class="cart-form-label">
                                            City
                                        </label>
                                        <input asp-for="OrderHeader.City"
                                               class="form-control cart-form-control"
                                               placeholder="City"
                                               autocomplete="address-level2" />
                                        <span asp-validation-for="OrderHeader.City"
                                              class="text-danger small"></span>
                                    </div>

                                    <div class="col-6">
                                        <label asp-for="OrderHeader.State" class="cart-form-label">
                                            County / Region
                                        </label>
                                        <input asp-for="OrderHeader.State"
                                               class="form-control cart-form-control"
                                               placeholder="County"
                                               autocomplete="address-level1" />
                                        <span asp-validation-for="OrderHeader.State"
                                              class="text-danger small"></span>
                                    </div>

                                    <div class="col-12">
                                        <label asp-for="OrderHeader.PostalCode" class="cart-form-label">
                                            Postcode
                                        </label>
                                        <input asp-for="OrderHeader.PostalCode"
                                               class="form-control cart-form-control"
                                               placeholder="Enter your postcode"
                                               autocomplete="postal-code" />
                                        <span asp-validation-for="OrderHeader.PostalCode"
                                              class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>

                        </fieldset>

                        <div class="checkout-divider"></div>

                        <!-- Order summary -->
                        <div class="checkout-section">
                            <h3 class="checkout-section-title">
                                <i class="bi bi-receipt"></i>
                                Order Summary
                            </h3>

                            @foreach (var item in Model.ShoppingCartList)
                            {
                                <div class="checkout-summary-item">
                                    <div class="checkout-summary-product">
                                        <span class="checkout-summary-name">
                                            @item.Product.Name
                                        </span>
                                        <span class="checkout-summary-quantity">
                                            Qty: @item.Count
                                        </span>
                                    </div>

                                    <span class="checkout-summary-price">
                                        @((item.Price * item.Count).ToString("c"))
                                    </span>
                                </div>
                            }

                            <div class="checkout-shipping-row">
                                <span>
                                    <i class="bi bi-truck me-2"></i>
                                    Shipping
                                </span>
                                <span class="checkout-free-shipping">Free</span>
                            </div>
                        </div>

                        <!-- Total -->
                        <div class="checkout-total">
                            <div>
                                <span class="checkout-total-label">Total to pay</span>
                                <span class="checkout-total-caption">Including selected items</span>
                            </div>

                            <span class="checkout-total-amount">
                                @Model.OrderHeader.OrderTotal.ToString("c")
                            </span>
                        </div>

                        <!-- Place order -->
                        <div class="checkout-submit-area">
                            <button type="submit"
                                    disabled="@(itemCount == 0)"
                                    class="btn cart-place-order-btn">
                                <i class="bi bi-lock-fill"></i>
                                Place Order
                                <i class="bi bi-arrow-right ms-auto"></i>
                            </button>

                            <div class="checkout-trust-note">
                                <i class="bi bi-shield-check"></i>
                                Your order details are protected.
                            </div>

                            <a asp-area="Customer"
                               asp-controller="Home"
                               asp-action="Index"
                               class="checkout-back-link">
                                <i class="bi bi-arrow-left me-1"></i>
                                Continue browsing
                            </a>
                        </div>

                    </div>
                </div>

            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function updateCart(cartId, count) {
            const quantity = Number.parseInt(count, 10);

            if (!Number.isInteger(quantity) || quantity < 1 || quantity > 99) {
                alert("Please enter a quantity between 1 and 99.");
                window.location.reload();
                return;
            }

            fetch('@Url.Action("UpdateCart", "Cart", new { area = "Customer" })', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded'
                },
                body: new URLSearchParams({
                    cartId: cartId,
                    count: quantity
                })
            })
                .then(response => {
                    if (!response.ok) {
                        throw new Error("Unable to update the cart.");
                    }

                    window.location.reload();
                })
                .catch(error => {
                    console.error(error);
                    alert("Your cart could not be updated. Please try again.");
                });
        }
    </script>

    <partial name="_ValidationScriptsPartial" />
}
