@using WebMagazines.Models
@model Category

@{
    ViewData["Title"] = "Delete Category";
}

<div class="container py-4 py-lg-5">

    <div class="row justify-content-center">

        <div class="col-12 col-md-10 col-lg-8 col-xl-7">

            <a asp-action="Index"
               class="text-decoration-none text-primary fw-semibold d-inline-flex align-items-center mb-4">

                <i class="bi bi-arrow-left me-2"></i>

                Back to Categories

            </a>

            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">

                <!-- Header -->
                <div class="card-header text-white py-4 px-4"
                     style="background:linear-gradient(135deg,#0f172a,#1e40af,#3b82f6);">

                    <h2 class="fw-bold mb-1">

                        <i class="bi bi-trash3-fill me-2"></i>

                        Delete Category

                    </h2>

                    <p class="mb-0 text-info">
                        Permanently remove this category from your store
                    </p>

                </div>

                <!-- Body -->
                <div class="card-body p-3 p-md-4 p-lg-5">

                    <div class="alert alert-warning d-flex align-items-center mb-4">

                        <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>

                        <div>
                            <strong>Warning!</strong><br />
                            This action cannot be undone. Please confirm that you want to delete this category.
                        </div>

                    </div>

                    <form method="post" asp-action="Delete">

                        <input asp-for="Id" type="hidden" />

                        <div class="mb-4">

                            <label asp-for="Name"
                                   class="form-label fw-semibold"></label>

                            <input asp-for="Name"
                                   class="form-control"
                                   readonly />

                        </div>

                        <div class="mb-4">

                            <label asp-for="DisplayOrder"
                                   class="form-label fw-semibold"></label>

                            <input asp-for="DisplayOrder"
                                   class="form-control"
                                   readonly />

                        </div>

                        <div class="d-grid d-md-flex gap-3">

                            <button type="submit"
                                    class="btn btn-danger btn-lg">

                                <i class="bi bi-trash3 me-2"></i>

                                Delete Category

                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-secondary btn-lg">

                                <i class="bi bi-x-circle me-2"></i>

                                Cancel

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}