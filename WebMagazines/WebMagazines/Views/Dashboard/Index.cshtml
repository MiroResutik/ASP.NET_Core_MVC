@model DashboardVM

<div class="mb-4">
    <h1 class="h4 fw-bold mb-1">Welcome back!</h1>
    <p class="text-secondary small mb-0">
        Here's what's happening with your store.
    </p>
</div>

<!-- Stats Cards -->
<div class="row g-3 g-xl-4 mb-4">

    <!-- Revenue -->
    <div class="col-sm-6 col-xl-3">
        <div class="dashboard-stat-card h-100">

            <div class="stat-card-top">
                <div class="stat-icon revenue">
                    <i class="bi bi-currency-pound"></i>
                </div>

                <span class="stat-label">Revenue</span>
            </div>

            <div class="stat-value">
                @Model.TotalRevenue.ToString("C")
            </div>

            <div class="stat-footer">
                <span>
                    <i class="bi bi-graph-up-arrow me-1"></i>
                    From approved orders
                </span>
            </div>

        </div>
    </div>


    <!-- Orders -->
    <div class="col-sm-6 col-xl-3">
        <a asp-area="Admin"
           asp-controller="Order"
           asp-action="Index"
           asp-route-status="all"
           class="dashboard-stat-card h-100 text-decoration-none">

            <div class="stat-card-top">
                <div class="stat-icon orders">
                    <i class="bi bi-cart3"></i>
                </div>

                <span class="stat-label">Orders</span>
            </div>

            <div class="stat-value">
                @Model.TotalOrders
            </div>

            <div class="stat-footer">
                <span>
                    View all orders
                    <i class="bi bi-arrow-right ms-1"></i>
                </span>
            </div>

        </a>
    </div>


    <!-- Products -->
    <div class="col-sm-6 col-xl-3">
        <a asp-area="Admin"
           asp-controller="Product"
           asp-action="Index"
           class="dashboard-stat-card h-100 text-decoration-none">

            <div class="stat-card-top">
                <div class="stat-icon products">
                    <i class="bi bi-book"></i>
                </div>

                <span class="stat-label">Products</span>
            </div>

            <div class="stat-value">
                @Model.TotalProducts
            </div>

            <div class="stat-footer">
                <span>
                    Manage products
                    <i class="bi bi-arrow-right ms-1"></i>
                </span>
            </div>

        </a>
    </div>


    <!-- Users -->
    <div class="col-sm-6 col-xl-3">
        <a asp-area="Admin"
           asp-controller="User"
           asp-action="Index"
           class="dashboard-stat-card h-100 text-decoration-none">

            <div class="stat-card-top">
                <div class="stat-icon users">
                    <i class="bi bi-people"></i>
                </div>

                <span class="stat-label">Users</span>
            </div>

            <div class="stat-value">
                @Model.TotalUsers
            </div>

            <div class="stat-footer">
                <span>
                    Manage users
                    <i class="bi bi-arrow-right ms-1"></i>
                </span>
            </div>

        </a>
    </div>

</div>


<!-- Charts Row 1 -->
<div class="row g-3 g-xl-4 mb-4">

    <!-- Revenue Trend -->
    <div class="col-lg-6">
        <div class="dashboard-chart-card h-100">

            <div class="chart-card-header">
                <div class="d-flex align-items-center gap-3">
                    <div class="chart-icon">
                        <i class="bi bi-graph-up-arrow"></i>
                    </div>

                    <div>
                        <h6 class="mb-1 fw-bold">Revenue Trend</h6>
                        <p class="mb-0 text-secondary">
                            Monthly revenue performance
                        </p>
                    </div>
                </div>

                <span class="chart-badge">
                    Revenue
                </span>
            </div>

            <div class="chart-container">
                <canvas id="revenueChart"></canvas>
            </div>

        </div>
    </div>


    <!-- Orders Per Month -->
    <div class="col-lg-6">
        <div class="dashboard-chart-card h-100">

            <div class="chart-card-header">
                <div class="d-flex align-items-center gap-3">
                    <div class="chart-icon">
                        <i class="bi bi-bar-chart-fill"></i>
                    </div>

                    <div>
                        <h6 class="mb-1 fw-bold">Orders Per Month</h6>
                        <p class="mb-0 text-secondary">
                            Monthly order volume
                        </p>
                    </div>
                </div>

                <span class="chart-badge">
                    Orders
                </span>
            </div>

            <div class="chart-container">
                <canvas id="ordersChart"></canvas>
            </div>

        </div>
    </div>

</div>


<!-- Charts Row 2 -->
<div class="row g-3 g-xl-4 mb-4">

    <!-- Order Status -->
    <div class="col-lg-6">
        <div class="dashboard-chart-card h-100">

            <div class="chart-card-header">
                <div class="d-flex align-items-center gap-3">
                    <div class="chart-icon">
                        <i class="bi bi-pie-chart-fill"></i>
                    </div>

                    <div>
                        <h6 class="mb-1 fw-bold">Order Status</h6>
                        <p class="mb-0 text-secondary">
                            Current order distribution
                        </p>
                    </div>
                </div>

                <span class="chart-badge">
                    Status
                </span>
            </div>

            <div class="chart-container chart-container-large d-flex align-items-center justify-content-center">
                <canvas id="statusChart"></canvas>
            </div>

        </div>
    </div>


    <!-- Products by Category -->
    <div class="col-lg-6">
        <div class="dashboard-chart-card h-100">

            <div class="chart-card-header">
                <div class="d-flex align-items-center gap-3">
                    <div class="chart-icon">
                        <i class="bi bi-tags-fill"></i>
                    </div>

                    <div>
                        <h6 class="mb-1 fw-bold">Products by Category</h6>
                        <p class="mb-0 text-secondary">
                            Product catalogue distribution
                        </p>
                    </div>
                </div>

                <span class="chart-badge">
                    Products
                </span>
            </div>

            <div class="chart-container chart-container-large d-flex align-items-center justify-content-center">
                <canvas id="categoryChart"></canvas>
            </div>

        </div>
    </div>

</div>

@section Scripts {
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
