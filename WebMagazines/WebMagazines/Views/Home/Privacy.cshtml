@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container py-4 py-lg-5">

    <!-- Page Header -->
    <div class="text-center mb-5">
        <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3"
             style="width:70px;height:70px;
            background:linear-gradient(135deg,#1e40af,#3b82f6);
            box-shadow:0 8px 20px rgba(37,99,235,.25);">
            <i class="bi bi-shield-lock-fill text-white fs-2"></i>
        </div>

        <h1 class="fw-bold mb-2">Privacy Policy</h1>

        <p class="text-muted mb-1">
            Your privacy is important to us.
        </p>

        <small class="text-muted">
            Last updated: 4 September 2026
        </small>
    </div>


    <!-- Privacy Policy Card -->
    <div class="row justify-content-center">
        <div class="col-12 col-lg-9 col-xl-8">

            <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

                <!-- Blue Header -->
                <div class="card-header text-white p-4"
                     style="background:linear-gradient(135deg,#0f172a,#1e40af,#3b82f6);">

                    <div class="d-flex align-items-center gap-3">
                        <i class="bi bi-shield-check fs-2"></i>

                        <div>
                            <h4 class="mb-1 fw-bold">WebMagazines Privacy Policy</h4>
                            <p class="mb-0 opacity-75">
                                How we collect, use and protect your information
                            </p>
                        </div>
                    </div>

                </div>


                <div class="card-body p-4 p-md-5">

                    <!-- Introduction -->
                    <section class="mb-5">
                        <h3 class="fw-bold mb-3">
                            <i class="bi bi-info-circle text-primary me-2"></i>
                            Introduction
                        </h3>

                        <p class="text-muted">
                            Welcome to WebMagazines. We respect your privacy and are
                            committed to protecting your personal information.
                        </p>

                        <p class="text-muted">
                            This Privacy Policy explains what information we may
                            collect when you use our website, how we use that
                            information, and the choices you have regarding your
                            personal data.
                        </p>
                    </section>


                    <!-- Information We Collect -->
                    <section class="mb-5">
                        <h3 class="fw-bold mb-3">
                            <i class="bi bi-person-lines-fill text-primary me-2"></i>
                            Information We Collect
                        </h3>

                        <p class="text-muted">
                            When you create an account, place an order or use
                            certain features of our website, we may collect
                            information such as:
                        </p>

                        <ul class="text-muted">
                            <li class="mb-2">Your name</li>
                            <li class="mb-2">Email address</li>
                            <li class="mb-2">Telephone number</li>
                            <li class="mb-2">Billing and delivery address</li>
                            <li class="mb-2">Account login information</li>
                            <li class="mb-2">Order and purchase information</li>
                            <li class="mb-2">Information you provide when contacting us</li>
                        </ul>
                    </section>


                    <!-- How We Use Information -->
                    <section class="mb-5">
                        <h3 class="fw-bold mb-3">
                            <i class="bi bi-gear text-primary me-2"></i>
                            How We Use Your Information
                        </h3>

                        <p class="text-muted">
                            We may use the information we collect to:
                        </p>

                        <ul class="text-muted">
                            <li class="mb-2">Create and manage your account</li>
                            <li class="mb-2">Process and fulfil your orders</li>
                            <li class="mb-2">Provide customer support</li>
                            <li class="mb-2">Communicate with you about your orders</li>
                            <li class="mb-2">Improve our website and services</li>
                            <li class="mb-2">Maintain the security of our website</li>
                            <li class="mb-2">Comply with applicable legal obligations</li>
                        </ul>
                    </section>


                    <!-- Account Information -->
                    <section class="mb-5">
                        <h3 class="fw-bold mb-3">
                            <i class="bi bi-person-check text-primary me-2"></i>
                            Your Account
                        </h3>

                        <p class="text-muted">
                            If you create an account with WebMagazines, you are
                            responsible for keeping your login credentials secure.
                            Please contact us if you believe that your account has
                            been accessed without your permission.
                        </p>
                    </section>


                    <!-- Orders and Payments -->
                    <section class="mb-5">
                        <h3 class="fw-bold mb-3">
                            <i class="bi bi-cart-check text-primary me-2"></i>
                            Orders and Payments
                        </h3>

                        <p class="text-muted">
                            We collect information necessary to process and fulfil
                            your orders. Payment information may be processed by
                            third-party payment providers where applicable.
                        </p>

                        <p class="text-muted">
                            We do not use your payment information for purposes
                            unrelated to processing your transactions.
                        </p>
                    </section>


                    <!-- Cookies -->
                    <section class="mb-5">
                        <h3 class="fw-bold mb-3">
                            <i class="bi bi-cookie text-primary me-2"></i>
                            Cookies
                        </h3>

                        <p class="text-muted">
                            WebMagazines may use cookies and similar technologies
                            to help the website function correctly and to improve
                            your browsing experience.
                        </p>

                        <p class="text-muted">
                            Cookies may be used to remember preferences, maintain
                            sessions and support features such as shopping carts
                            and authenticated accounts.
                        </p>
                    </section>


                    <!-- Data Security -->
                    <section class="mb-5">
                        <h3 class="fw-bold mb-3">
                            <i class="bi bi-shield-lock text-primary me-2"></i>
                            Data Security
                        </h3>

                        <p class="text-muted">
                            We take reasonable measures to protect your personal
                            information against unauthorised access, alteration,
                            disclosure or destruction.
                        </p>

                        <p class="text-muted">
                            However, no method of transmitting or storing information
                            electronically can be guaranteed to be completely secure.
                        </p>
                    </section>


                    <!-- Data Retention -->
                    <section class="mb-5">
                        <h3 class="fw-bold mb-3">
                            <i class="bi bi-database-check text-primary me-2"></i>
                            Data Retention
                        </h3>

                        <p class="text-muted">
                            We retain personal information only for as long as
                            reasonably necessary to provide our services, fulfil
                            legal or accounting requirements, resolve disputes and
                            enforce our agreements.
                        </p>
                    </section>


                    <!-- Your Rights -->
                    <section class="mb-5">
                        <h3 class="fw-bold mb-3">
                            <i class="bi bi-person-vcard text-primary me-2"></i>
                            Your Rights
                        </h3>

                        <p class="text-muted">
                            Depending on applicable data protection laws, you may
                            have rights regarding your personal information,
                            including the right to:
                        </p>

                        <ul class="text-muted">
                            <li class="mb-2">Request access to your personal information</li>
                            <li class="mb-2">Request correction of inaccurate information</li>
                            <li class="mb-2">Request deletion of certain information</li>
                            <li class="mb-2">Object to or restrict certain processing</li>
                            <li class="mb-2">Request a copy of your personal information</li>
                        </ul>

                        <p class="text-muted">
                            To exercise your rights, please contact us using the
                            contact details provided below.
                        </p>
                    </section>


                    <!-- Third Parties -->
                    <section class="mb-5">
                        <h3 class="fw-bold mb-3">
                            <i class="bi bi-diagram-3 text-primary me-2"></i>
                            Third-Party Services
                        </h3>

                        <p class="text-muted">
                            We may use trusted third-party service providers to
                            support website functionality, payment processing,
                            hosting, analytics, security and other services.
                        </p>

                        <p class="text-muted">
                            These providers may process personal information on our
                            behalf where necessary to provide their services.
                        </p>
                    </section>


                    <!-- Changes -->
                    <section class="mb-5">
                        <h3 class="fw-bold mb-3">
                            <i class="bi bi-arrow-repeat text-primary me-2"></i>
                            Changes to This Policy
                        </h3>

                        <p class="text-muted">
                            We may update this Privacy Policy from time to time to
                            reflect changes to our services, technology or legal
                            requirements.
                        </p>

                        <p class="text-muted">
                            Any changes will be posted on this page together with
                            the updated date.
                        </p>
                    </section>


                    <!-- Contact -->
                    <section>
                        <div class="p-4 rounded-4"
                             style="background:#eff6ff;border:1px solid #bfdbfe;">

                            <h3 class="fw-bold mb-3">
                                <i class="bi bi-envelope text-primary me-2"></i>
                                Contact Us
                            </h3>

                            <p class="text-muted mb-0">
                                If you have any questions about this Privacy Policy
                                or how we handle your personal information, please
                                contact the WebMagazines team.
                            </p>

                        </div>
                    </section>

                </div>


                <!-- Footer -->
                <div class="card-footer bg-white border-top p-4 text-center">

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="btn btn-primary px-4 rounded-3">

                        <i class="bi bi-house me-2"></i>
                        Back to Home

                    </a>

                </div>

            </div>

        </div>
    </div>

</div>