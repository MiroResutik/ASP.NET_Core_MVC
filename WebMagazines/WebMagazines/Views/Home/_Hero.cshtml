<!-- Moto Editorial Hero -->
<section class="moto-hero">

    <div class="container position-relative">

        <div class="row align-items-center g-4 g-lg-5">

            <!-- Left: Hero Content -->
            <div class="col-12 col-lg-6">

                <div class="moto-hero-content">

                    <div class="moto-eyebrow">
                        <span class="moto-eyebrow-line"></span>
                        THE MOTORCYCLE EDITION
                    </div>

                    <h1 class="moto-hero-title">
                        Fuel your
                        <span>passion</span>
                        for two wheels.
                    </h1>

                    <p class="moto-hero-description">
                        Discover motorcycle magazines, riding guides and
                        stories made for those who live for the open road.
                        From superbikes and adventure touring to classic
                        machines and custom builds.
                    </p>

                    <!-- Actions -->
                    <div class="moto-hero-actions">

                        <a href="#catalog" class="moto-btn-primary">
                            Explore the collection
                            <i class="bi bi-arrow-up-right"></i>
                        </a>
                        <!-- Actions 
                        <a href="#catalog" class="moto-btn-secondary">
                            <i class="bi bi-grid"></i>
                            Browse categories
                        </a>
                        -->
                    </div>

                    <!-- Editorial Note -->
                    <div class="moto-hero-note">
                        <div class="moto-note-icon">
                            <i class="bi bi-book-half"></i>
                        </div>

                        <div>
                            <span class="moto-note-title">
                                Made for motorcycle enthusiasts
                            </span>
                            <span class="moto-note-text">
                                Your next great read starts here.
                            </span>
                        </div>
                    </div>

                </div>

            </div>


            <!-- Right: Motorcycle Visual -->
            <div class="col-12 col-lg-6">

                <div class="moto-hero-visual">

                    <!-- Decorative background -->
                    <div class="moto-visual-glow"></div>
                    <div class="moto-visual-ring moto-ring-one"></div>
                    <div class="moto-visual-ring moto-ring-two"></div>

                    <!-- Motorcycle Image -->
                    <div class="moto-image-frame">

                        <img src="~/images/hero-motorcycle.png"
                             alt="Motorcycle on an open road"
                             class="moto-hero-image"
                             loading="eager" />

                        <div class="moto-image-overlay"></div>

                        <div class="moto-image-caption">
                            <span class="moto-caption-label">
                                THE OPEN ROAD
                            </span>

                            <span class="moto-caption-title">
                                Every ride has a story.
                            </span>
                        </div>

                        <div class="moto-image-index">
                            <span>01</span>
                            <span class="moto-index-line"></span>
                            <span>03</span>
                        </div>

                    </div>
                    <!-- Floating editorial label

                        <div class="moto-floating-label">
                        <i class="bi bi-speedometer2"></i>

                        <div>
                            <span>LIVE THE RIDE</span>
                            <small>READ THE STORY</small>
                        </div>
                    </div>
                    -->
                    
                    
                    
                </div>

            </div>

        </div>


        <!-- Bottom Category Strip -->
        <div class="moto-category-strip">

            <a href="#catalog" class="moto-category-item">
                <span class="moto-category-number">01</span>
                <span class="moto-category-name">
                    Adventure & Touring
                </span>
                <i class="bi bi-arrow-up-right"></i>
            </a>

            <a href="#catalog" class="moto-category-item">
                <span class="moto-category-number">02</span>
                <span class="moto-category-name">
                    Sport & Performance
                </span>
                <i class="bi bi-arrow-up-right"></i>
            </a>

            <a href="#catalog" class="moto-category-item">
                <span class="moto-category-number">03</span>
                <span class="moto-category-name">
                    Classic & Custom
                </span>
                <i class="bi bi-arrow-up-right"></i>
            </a>

        </div>

    </div>

</section>