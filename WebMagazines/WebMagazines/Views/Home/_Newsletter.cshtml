<!-- Newsletter Section -->
<section class="py-5 bg-light">
    <div class="container">

        <div class="row justify-content-center">

            <div class="col-lg-8">

                <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

                    <div class="card-header text-white text-center py-4"
                         style="background: linear-gradient(135deg,#1e3a8a,#2563eb,#3b82f6);">

                        <i class="bi bi-envelope-heart-fill display-4"></i>

                        <h3 class="fw-bold mt-3 mb-2">
                            Stay Updated
                        </h3>

                        <p class="mb-0 text-white-50">
                            Subscribe to receive special offers, exclusive discounts and the latest arrivals.
                        </p>

                    </div>

                    <div class="card-body p-5">

                        <form class="row g-3 justify-content-center">

                            <div class="col-lg-8">

                                <label class="form-label fw-semibold">
                                    Email Address
                                </label>

                                <input type="email"
                                       name="email"
                                       class="form-control form-control-lg rounded-3"
                                       placeholder="name@example.com"
                                       required />

                            </div>

                            <div class="col-lg-4 d-grid align-self-end">

                                <button type="submit"
                                        class="btn btn-accent btn-lg rounded-3">

                                    <i class="bi bi-send-fill me-2"></i>
                                    Subscribe

                                </button>

                            </div>

                        </form>

                        <hr class="my-4">

                        <div class="row text-center">

                            <div class="col-md-4 mb-3 mb-md-0">

                                <i class="bi bi-percent fs-2 text-primary"></i>

                                <h6 class="fw-bold mt-2 mb-1">
                                    Exclusive Offers
                                </h6>

                                <small class="text-muted">
                                    Receive members-only discounts.
                                </small>

                            </div>

                            <div class="col-md-4 mb-3 mb-md-0">

                                <i class="bi bi-bell fs-2 text-primary"></i>

                                <h6 class="fw-bold mt-2 mb-1">
                                    New Products
                                </h6>

                                <small class="text-muted">
                                    Be first to discover new arrivals.
                                </small>

                            </div>

                            <div class="col-md-4">

                                <i class="bi bi-shield-check fs-2 text-primary"></i>

                                <h6 class="fw-bold mt-2 mb-1">
                                    No Spam
                                </h6>

                                <small class="text-muted">
                                    Your email is always safe with us.
                                </small>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>
</section>
