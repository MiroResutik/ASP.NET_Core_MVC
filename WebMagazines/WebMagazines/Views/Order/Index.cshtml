@using WebMagazines.Utility
@{
    ViewData["Title"] = "Order List";
    // var inactive = "btn btn-sm btn-outline-light";
    // var active = "btn text-white btn-sm";

    var inactive = "btn text-white btn-sm";
    var active = "btn btn-sm btn-outline-light btn-success";

    var status = Context.Request.Query["status"].ToString().ToLower();
    var approved = inactive;
    var processing = inactive;
    var shipped = inactive;
    var cancelled = inactive;
    var refunded = inactive;
    var completed = inactive;
    var all = inactive;

    switch (status)
    {
        case "approved":
            approved = active;
            break;
        case "processing":
            processing = active;
            break;
        case "shipped":
            shipped = active;
            break;
        case "cancelled":
            cancelled = active;
            break;
        case "refunded":
            refunded = active;
            break;
        case "completed":
            completed = active;
            break;
        default:
            status = "all";
            all = active;
            break;
    }

    var isCustomer = User.IsInRole(SD.RoleCustomer);
    var containerClass = isCustomer ? "container my-4 pt-3" : "container-fluid";
}



<div class="@containerClass">
    <div class="card border shadow-sm overflow-hidden">
        <div class="card-header text-white py-3 px-4 d-flex align-items-center justify-content-between" style="background:linear-gradient(135deg,#0f172a,#1e40af,#3b82f6);">
            <div>
                <h5 class="mb-0 fw-bold"><i class="bi bi-grid me-2"></i>Orders</h5>
                <p class="mb-0 small" style="color: white;">Manage your orders</p>
            </div>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <span class="text-uppercase fw-semibold me-1" style="font-size: 0.95rem; letter-spacing: 0.1em; color: white;">Quick Filter by Status:</span>
                <a class="@all" asp-controller="Order" asp-action="Index" asp-route-status="all">All</a>
                <a class="@approved" asp-controller="Order" asp-action="Index" asp-route-status="approved">Approved</a>
                <a class="@processing" asp-controller="Order" asp-action="Index" asp-route-status="processing">Processing</a>
                <a class="@shipped" asp-controller="Order" asp-action="Index" asp-route-status="shipped">Shipped</a>
                <a class="@cancelled" asp-controller="Order" asp-action="Index" asp-route-status="cancelled">Cancelled</a>
                <a class="@refunded" asp-controller="Order" asp-action="Index" asp-route-status="refunded">Refunded</a>
                <a class="@completed" asp-controller="Order" asp-action="Index" asp-route-status="completed">Completed</a>
            </div>
        </div>
        <div class="table-responsive p-3">
            <table id="tblData" class="table-styled">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Name</th>
                        <th>Phone Number</th>
                        <th>Email</th>
                        <th>Status</th>
                        <th>Total</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

            </table>
        </div>
    </div>
</div>
@section Scripts {
    <script src="~/js/orders.js" asp-append-version="true"></script>

}
