<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - WebMagazines</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebMagazines.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="//cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/css/toastr.css" />
    <link rel="stylesheet" href="//cdn.datatables.net/2.3.8/css/dataTables.dataTables.min.css" />

    <style>

            body {
                font-family: "Inter", sans-serif;
                background: #f8fafc;
                color: #1e293b;
            }

            /*=========================
                        Sidebar
                    =========================*/

            .admin-sidebar {
                width: 270px;
                background: linear-gradient(180deg,#1e3a8a,#2563eb,#3b82f6);
                color: white;
                box-shadow: 8px 0 30px rgba(37,99,235,.15);
            }

            .admin-sidebar-header {
                padding: 2rem 1rem;
                text-align: center;
                border-bottom: 1px solid rgba(255,255,255,.15);
            }

                .admin-sidebar-header h3 {
                    color: white;
                    font-weight: 700;
                    margin-top: .5rem;
                }

                .admin-sidebar-header small {
                    color: rgba(255,255,255,.75);
                }

            .admin-sidebar-nav .nav-section {
                color: rgba(255,255,255,.65);
                font-size: .72rem;
                font-weight: 700;
                letter-spacing: .15rem;
                text-transform: uppercase;
                margin-top: 1rem;
                padding: .5rem 1rem;
            }

            .admin-sidebar-nav .nav-link {
                color: rgba(255,255,255,.92);
                border-radius: 12px;
                padding: .8rem 1rem;
                margin-bottom: .35rem;
                transition: .25s;
                display: flex;
                align-items: center;
                gap: .75rem;
            }

                .admin-sidebar-nav .nav-link:hover {
                    background: rgba(255,255,255,.15);
                    color: white;
                    transform: translateX(4px);
                }

                .admin-sidebar-nav .nav-link.active {
                    background: white;
                    color: #2563eb;
                    font-weight: 600;
                    box-shadow: 0 8px 20px rgba(0,0,0,.12);
                }

                    .admin-sidebar-nav .nav-link.active i {
                        color: #2563eb;
                    }

            /*=========================
                        User Section
                    =========================*/

            .admin-user {
                background: rgba(255,255,255,.10);
                border-radius: 15px;
                padding: 1rem;
            }

            /*=========================
                        Buttons
                    =========================*/

            .btn-admin {
                background: linear-gradient(135deg,#2563eb,#3b82f6);
                border: none;
                color: white;
                border-radius: 10px;
            }

                .btn-admin:hover {
                    background: linear-gradient(135deg,#1d4ed8,#2563eb);
                    color: white;
                }

            /*=========================
                        Main Content
                    =========================*/

            main {
                background: #f8fafc;
                min-height: 100vh;
            }

            /*=========================
                        Scrollbar
                    =========================*/

            .admin-sidebar::-webkit-scrollbar {
                width: 6px;
            }

            .admin-sidebar::-webkit-scrollbar-thumb {
                background: rgba(255,255,255,.3);
                border-radius: 20px;
            }

            /*=========================
                        Mobile Header
                    =========================*/

            .mobile-header {
                background: linear-gradient(90deg,#1e3a8a,#2563eb,#3b82f6);
            }

    </style>

</head>

<body>

    <!-- Mobile Header -->

    <div class="d-lg-none sticky-top mobile-header shadow-sm">

        <div class="d-flex justify-content-between align-items-center p-3">

            <button class="btn text-white"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#sidebarOffcanvas">

                <i class="bi bi-list fs-3"></i>

            </button>

            <h5 class="text-white fw-bold mb-0">
                Admin Panel
            </h5>

            <span></span>

        </div>

    </div>


    <!-- Mobile Sidebar -->

    <div class="offcanvas offcanvas-start"
         id="sidebarOffcanvas"
         style="background:linear-gradient(180deg,#1e3a8a,#2563eb,#3b82f6);">

        <div class="offcanvas-header border-bottom border-light border-opacity-25">

            <h5 class="text-white fw-bold mb-0">
                Web Magazines
            </h5>

            <button class="btn-close btn-close-white"
                    data-bs-dismiss="offcanvas">
            </button>

        </div>

        <div class="offcanvas-body">

            <partial name="_AdminSidebarNav" />

        </div>

    </div>


    <div class="d-flex">

        <!-- Desktop Sidebar -->

        <aside class="admin-sidebar d-none d-lg-flex flex-column position-sticky top-0"
               style="height:100vh;">

            <div class="admin-sidebar-header">

                <!-- Desktop_Sidebare_Image -->
                <!-- <i class="bi bi-journal-richtext display-1 text-white"></i> -->
                <a asp-area="Customer"
                   asp-controller="Home"
                   asp-action="Index"
                   class="text-decoration-none">

                    <i class="bi bi-image-alt display-1 text-white"></i>

                </a>
                <!-- <img src="/images/Bike_Icon_8.png" style="width: 105px; height: 105px;" /> -->
                


                <h3>
                    <a asp-area="Customer"
                       asp-controller="Home"
                       asp-action="Index"
                       class="text-decoration-none text-white">
                        
                    Web Magazines
                    </a>
                </h3>

                <small>
                    Administration Panel
                </small>

            </div>

            <nav class="admin-sidebar-nav flex-grow-1 overflow-auto p-3">

                <partial name="_AdminSidebarNav" />

            </nav>

            <div class="p-3 border-top border-light border-opacity-25">

                <div class="admin-user mb-3">

                    <div class="d-flex align-items-center">

                        <div class="rounded-circle bg-white text-primary d-flex justify-content-center align-items-center"
                             style="width:45px;height:45px;">

                            <i class="bi bi-person-fill"></i>

                        </div>

                        <div class="ms-3">

                            <div class="fw-semibold text-white">

                                @User.Identity?.Name

                            </div>

                            <small class="text-white-50">

                                Admin Powers Unlocked

                            </small>

                        </div>

                    </div>

                </div>

                <div class="d-grid gap-2">

                    <a asp-area="Customer"
                       asp-controller="Home"
                       asp-action="Index"
                       class="btn btn-admin">

                        <i class="bi bi-shop me-2"></i>

                        Visit Store

                    </a>

                    <form asp-area="Identity"
                          asp-controller="Account"
                          asp-action="Logout"
                          method="post">

                        <button class="btn btn-outline-light w-100">

                            <i class="bi bi-box-arrow-right me-2"></i>

                            Logout

                        </button>

                    </form>

                </div>

            </div>

        </aside>


        <!-- Main -->

        <main class="flex-grow-1">

            <div class="container-fluid py-4 px-lg-5">

                <partial name="_Notification" />

                @RenderBody()

            </div>

        </main>

    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/js/toastr.min.js"></script>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    <script src="//cdn.datatables.net/2.3.8/js/dataTables.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>