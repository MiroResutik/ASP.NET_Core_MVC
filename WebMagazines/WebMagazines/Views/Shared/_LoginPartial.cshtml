@using Microsoft.AspNetCore.Identity

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager

@if (SignInManager.IsSignedIn(User))
{
    <div class="d-flex align-items-center gap-3">

        <div class="d-flex align-items-center">
            <div class="rounded-circle bg-primary d-flex justify-content-center align-items-center me-2"
                 style="width:38px;height:38px;">
                <i class="bi bi-person-fill text-white"></i>
            </div>

            <div class="d-none d-md-block">
                <small class="text-secondary text-white">
                    Welcome back
                </small>
                <div class="fw-semibold text-white small">
                    @UserManager.GetUserName(User)
                </div>
                
            </div>
        </div>

        <form method="post"
              asp-area="Identity"
              asp-controller="Account"
              asp-action="Logout">

            <button type="submit" class="btn btn-outline-info btn-sm rounded-pill px-3">
                <i class="bi bi-box-arrow-right me-1"></i>
                Logout
            </button>

        </form>

    </div>
}
else
{
    <div class="d-flex gap-2">

        <a asp-area=""
           asp-controller="Account"
           asp-action="Login"
           class="btn btn-outline-primary rounded-pill px-4">

            <i class="bi bi-box-arrow-in-right me-1"></i>
            Login

        </a>

        <a asp-area=""
           asp-controller="Account"
           asp-action="Register"
           class="btn btn-primary rounded-pill px-4">

            <i class="bi bi-person-plus me-1"></i>
            Register

        </a>

    </div>
}