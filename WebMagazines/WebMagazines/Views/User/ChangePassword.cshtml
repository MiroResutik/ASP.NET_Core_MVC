@model AdminChangePasswordVM

@{
    ViewData["Title"] = "Change User Password";
}

<div class="container py-4 py-lg-5">

    <div class="row justify-content-center">

        <div class="col-md-8 col-lg-6">

            <!-- Back button -->
            <a asp-action="Index"
               class="d-inline-flex align-items-center gap-2 text-secondary mb-4 text-decoration-none">
                <i class="bi bi-arrow-left"></i>
                Back to Users
            </a>

            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">

                <!-- Header -->
                <div class="card-header text-white py-4 px-4"
                     style="background:linear-gradient(135deg,#0f172a,#1e40af,#3b82f6);">

                    <div class="d-flex align-items-center">

                        <div class="rounded-circle d-flex align-items-center justify-content-center me-3"
                             style="width:55px; height:55px; background:rgba(255,255,255,0.15);">

                            <i class="bi bi-key-fill fs-3 text-white"></i>

                        </div>

                        <div>

                            <h4 class="fw-bold mb-1">
                                Change User Password
                            </h4>

                            <p class="mb-0 small text-white-50">
                                Admin password reset
                            </p>

                        </div>

                    </div>

                </div>

                <!-- Body -->
                <div class="card-body p-4 p-lg-5">

                    <!-- Admin Warning -->
                    <div class="alert border-0 d-flex align-items-center mb-4"
                         style="background:#eff6ff; color:#1e40af;">

                        <i class="bi bi-shield-lock-fill fs-4 me-3"></i>

                        <div>

                            <strong>Admin Action</strong>

                            <div class="small">
                                You are changing the password for another user.
                                No old password is required.
                            </div>

                        </div>

                    </div>

                    <!-- User Information -->
                    <div class="rounded-3 p-4 mb-4"
                         style="background:linear-gradient(135deg,#0f172a,#1e40af,#3b82f6);">

                        <div class="d-flex align-items-center">

                            <div class="rounded-circle d-flex align-items-center justify-content-center me-3"
                                 style="width:45px; height:45px; background:rgba(255,255,255,0.15);">

                                <i class="bi bi-person-fill text-white fs-5"></i>

                            </div>

                            <div>

                                <p class="small text-white-50 mb-1">
                                    User Email
                                </p>

                                <p class="mb-0 fw-semibold text-white">
                                    @Model.UserEmail
                                </p>

                            </div>

                        </div>

                    </div>

                    <!-- Form -->
                    <form method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <input asp-for="UserId" hidden />
                        <input asp-for="UserEmail" hidden />

                        <!-- New Password -->
                        <div class="mb-4">

                            <label asp-for="NewPassword"
                                   class="form-label fw-semibold">

                                <i class="bi bi-lock me-1 text-primary"></i>
                                New Password

                            </label>

                            <input asp-for="NewPassword"
                                   type="password"
                                   class="form-control form-control-lg"
                                   placeholder="Enter new password" />

                            <span asp-validation-for="NewPassword"
                                  class="text-danger small">
                            </span>

                            <div class="form-text">

                                <i class="bi bi-info-circle me-1"></i>

                                Minimum 6 characters

                            </div>

                        </div>

                        <!-- Confirm Password -->
                        <div class="mb-4">

                            <label asp-for="ConfirmPassword"
                                   class="form-label fw-semibold">

                                <i class="bi bi-lock-fill me-1 text-primary"></i>
                                Confirm Password

                            </label>

                            <input asp-for="ConfirmPassword"
                                   type="password"
                                   class="form-control form-control-lg"
                                   placeholder="Confirm new password" />

                            <span asp-validation-for="ConfirmPassword"
                                  class="text-danger small">
                            </span>

                        </div>

                        <!-- Actions -->
                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary px-4">

                                <i class="bi bi-x-circle me-1"></i>
                                Cancel

                            </a>

                            <button type="submit"
                                    class="btn text-white px-4"
                                    style="background:#2563eb; border-color:#2563eb;">

                                <i class="bi bi-check-circle me-1"></i>
                                Change Password

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}