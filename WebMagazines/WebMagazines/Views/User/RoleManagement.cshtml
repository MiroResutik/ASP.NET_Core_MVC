@model RoleManagmentVM

@{
    ViewData["Title"] = "Manage User Role";
}

<div class="container py-4 py-lg-5">

    <div class="row justify-content-center">

        <div class="col-12 col-lg-9 col-xl-8">

            <!-- Back Button -->
            <a asp-action="Index"
               class="text-decoration-none text-secondary small fw-medium d-inline-flex align-items-center gap-2 mb-3">
                <i class="bi bi-arrow-left"></i>
                Back to Users
            </a>

            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">

                <!-- Header -->
                <div class="card-header text-white py-4 px-4"
                     style="background: linear-gradient(135deg, #0f172a, #1e40af, #3b82f6);">

                    <div class="d-flex align-items-center gap-3">

                        <div class="d-flex align-items-center justify-content-center rounded-circle"
                             style="width: 52px; height: 52px; background: rgba(255,255,255,0.15);">
                            <i class="bi bi-shield-check fs-3 text-white"></i>
                        </div>

                        <div>
                            <h3 class="fw-bold mb-1">
                                Manage User Role
                            </h3>

                            <p class="mb-0 text-info">
                                Assign roles and manage user permissions
                            </p>
                        </div>

                    </div>

                </div>

                <!-- Body -->
                <div class="card-body p-4 p-md-5">

                    <form method="post">

                        <!-- Hidden User ID -->
                        <input asp-for="ApplicationUser.Id" type="hidden" />

                        <!-- User Information -->
                        <div class="mb-4">

                            <div class="d-flex align-items-center gap-2 mb-3">

                                <div class="d-flex align-items-center justify-content-center rounded-circle"
                                     style="width: 38px; height: 38px; background: rgba(59,130,246,0.1);">

                                    <i class="bi bi-person fs-5 text-primary"></i>

                                </div>

                                <div>
                                    <h5 class="fw-bold mb-0">
                                        User Information
                                    </h5>

                                    <small class="text-secondary">
                                        Details for the selected user
                                    </small>
                                </div>

                            </div>


                            <div class="border rounded-3 p-3 p-md-4 bg-light">

                                <div class="row g-4">

                                    <!-- Name -->
                                    <div class="col-md-6">

                                        <div class="d-flex align-items-center gap-3">

                                            <div class="d-flex align-items-center justify-content-center rounded-circle bg-white border"
                                                 style="width: 42px; height: 42px;">

                                                <i class="bi bi-person text-primary"></i>

                                            </div>

                                            <div>

                                                <small class="text-secondary d-block">
                                                    Full Name
                                                </small>

                                                <span class="fw-semibold">
                                                    @Model.ApplicationUser.Name
                                                </span>

                                            </div>

                                        </div>

                                    </div>


                                    <!-- Email -->
                                    <div class="col-md-6">

                                        <div class="d-flex align-items-center gap-3">

                                            <div class="d-flex align-items-center justify-content-center rounded-circle bg-white border"
                                                 style="width: 42px; height: 42px;">

                                                <i class="bi bi-envelope text-primary"></i>

                                            </div>

                                            <div style="min-width: 0;">

                                                <small class="text-secondary d-block">
                                                    Email Address
                                                </small>

                                                <span class="fw-semibold text-truncate d-block">
                                                    @Model.ApplicationUser.Email
                                                </span>

                                            </div>

                                        </div>

                                    </div>


                                    <!-- Phone -->
                                    <div class="col-md-6">

                                        <div class="d-flex align-items-center gap-3">

                                            <div class="d-flex align-items-center justify-content-center rounded-circle bg-white border"
                                                 style="width: 42px; height: 42px;">

                                                <i class="bi bi-telephone text-primary"></i>

                                            </div>

                                            <div>

                                                <small class="text-secondary d-block">
                                                    Phone Number
                                                </small>

                                                <span class="fw-semibold">
                                                    @(Model.ApplicationUser.PhoneNumber ?? "Not provided")
                                                </span>

                                            </div>

                                        </div>

                                    </div>


                                    <!-- Current Role -->
                                    <div class="col-md-6">

                                        <div class="d-flex align-items-center gap-3">

                                            <div class="d-flex align-items-center justify-content-center rounded-circle bg-white border"
                                                 style="width: 42px; height: 42px;">

                                                <i class="bi bi-person-badge text-primary"></i>

                                            </div>

                                            <div>

                                                <small class="text-secondary d-block mb-1">
                                                    Current Role
                                                </small>

                                                <span class="badge px-3 py-2"
                                                      style="background: #1e40af;">

                                                    <i class="bi bi-shield-check me-1"></i>
                                                    @Model.ApplicationUser.Role

                                                </span>

                                            </div>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- Role Selection -->
                        <div class="mb-4">

                            <div class="d-flex align-items-center gap-2 mb-3">

                                <div class="d-flex align-items-center justify-content-center rounded-circle"
                                     style="width: 38px; height: 38px; background: rgba(59,130,246,0.1);">

                                    <i class="bi bi-shield-lock text-primary"></i>

                                </div>

                                <div>

                                    <h5 class="fw-bold mb-0">
                                        Role Assignment
                                    </h5>

                                    <small class="text-secondary">
                                        Select the role for this user
                                    </small>

                                </div>

                            </div>


                            <label asp-for="ApplicationUser.Role"
                                   class="form-label fw-semibold">

                                Assign New Role

                            </label>


                            <select asp-for="ApplicationUser.Role"
                                    asp-items="@Model.RoleList"
                                    class="form-select form-select-lg">

                                <option value="">
                                    -- Select Role --
                                </option>

                            </select>


                            <div class="form-text mt-2">

                                <i class="bi bi-info-circle me-1 text-primary"></i>

                                Choose the appropriate permission level for this user.

                            </div>

                        </div>


                        <!-- Role Descriptions -->
                        <div class="border rounded-3 overflow-hidden mb-4">

                            <div class="px-3 py-2 text-white"
                                 style="background: #1e40af;">

                                <span class="fw-semibold small">

                                    <i class="bi bi-info-circle me-2"></i>
                                    Role Permissions

                                </span>

                            </div>


                            <div class="bg-light p-3">

                                <div class="row g-3">

                                    <!-- Customer -->
                                    <div class="col-md-4">

                                        <div class="bg-white border rounded-3 p-3 h-100">

                                            <i class="bi bi-person text-primary fs-5"></i>

                                            <p class="fw-bold mb-1 mt-2">
                                                Customer
                                            </p>

                                            <small class="text-secondary">
                                                Can browse and purchase products.
                                            </small>

                                        </div>

                                    </div>


                                    <!-- Employee -->
                                    <div class="col-md-4">

                                        <div class="bg-white border rounded-3 p-3 h-100">

                                            <i class="bi bi-briefcase text-primary fs-5"></i>

                                            <p class="fw-bold mb-1 mt-2">
                                                Employee
                                            </p>

                                            <small class="text-secondary">
                                                Can manage orders and inventory.
                                            </small>

                                        </div>

                                    </div>


                                    <!-- Admin -->
                                    <div class="col-md-4">

                                        <div class="bg-white border rounded-3 p-3 h-100">

                                            <i class="bi bi-shield-check text-primary fs-5"></i>

                                            <p class="fw-bold mb-1 mt-2">
                                                Admin
                                            </p>

                                            <small class="text-secondary">
                                                Full system access and user management.
                                            </small>

                                        </div>

                                    </div>

                                </div>

                            </div>

                        </div>


                        <!-- Action Buttons -->
                        <div class="d-flex flex-column flex-sm-row gap-2 justify-content-end border-top pt-4">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary px-4 order-2 order-sm-1">

                                <i class="bi bi-x-circle me-1"></i>
                                Cancel

                            </a>


                            <button type="submit"
                                    class="btn px-4 text-white order-1 order-sm-2"
                                    style="background: #1e40af;">

                                <i class="bi bi-check-circle me-1"></i>
                                Update Role

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}